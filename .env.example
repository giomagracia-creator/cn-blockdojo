# Copy to apps/web/.env.local for local dev.
# On Vercel, set these in Project Settings > Environment Variables.
# Never commit real values.

# Supabase project URL, for example https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon public key. Safe to expose to the browser. Not a service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used later for admin jobs. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
